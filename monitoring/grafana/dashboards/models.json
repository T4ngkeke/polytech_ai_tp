              "expr": "histogram_quantile(0.95, sum by (server, le) (rate(vllm:inter_token_latency_seconds_bucket{server!~\"Reranker|Embeddings\"}[$__rate_interval])))",
              "legendFormat": "{{server}} 95%",
              "range": true,
