            "justifyMode": "center",
            "orientation": "auto",
            "wideLayout": true
          }
        },
        {
          "type": "timeseries",
          "id": 7,
          "title": "Time to first token",
          "description": "From the request to the first written token: queue + reading the prompt (prefill). Long prompts (Research, many pages read) take longer.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 16,
            "w": 8,
            "h": 8
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "histogram_quantile(0.5, sum by (server, le) (rate(vllm:time_to_first_token_seconds_bucket[$__rate_interval])))",
              "legendFormat": "{{server}} median",
              "range": true,
              "instant": false,
              "refId": "A"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "histogram_quantile(0.95, sum by (server, le) (rate(vllm:time_to_first_token_seconds_bucket[$__rate_interval])))",
              "legendFormat": "{{server}} 95%",
              "range": true,
              "instant": false,
              "refId": "B"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "lineWidth": 2,
                "fillOpacity": 15,
                "showPoints": "never",
                "spanNulls": false,
                "stacking": {
                  "mode": "none"
                }
              },
              "min": 0
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
