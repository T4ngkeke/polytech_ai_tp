        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (server) (vllm:kv_cache_usage_perc{server!~\"Reranker|Embeddings\"})",
          "legendFormat": "{{server}}",
          "range": false,
          "instant": true,
