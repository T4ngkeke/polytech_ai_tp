        "h": 1
      },
      "panels": [
        {
          "type": "timeseries",
          "id": 14,
          "title": "Prefix cache hits",
          "description": "Share of prompt tokens taken from the cache instead of computed. Research runs resend the whole conversation at each step, so most of it is a hit.",
