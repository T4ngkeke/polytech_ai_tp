            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 7,
            "w": 8,
            "h": 8
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "sum by (server) (rate(vllm:prefix_cache_hits_total[$__rate_interval])) / sum by (server) (rate(vllm:prefix_cache_queries_total[$__rate_interval]))",
              "legendFormat": "{{server}}",
              "range": true,
              "instant": false,
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "custom": {
                "lineWidth": 2,
                "fillOpacity": 15,
                "showPoints": "never",
