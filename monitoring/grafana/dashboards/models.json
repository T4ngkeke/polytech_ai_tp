              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "histogram_quantile(0.95, sum by (server, le) (rate(vllm:request_prefill_time_seconds_bucket{server=\"LLM (Flash-Next)\"}[$__rate_interval])))",
