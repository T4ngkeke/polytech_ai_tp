# Copy outside the repository, chmod 600, and replace every secret.
# Database password should contain only hex/alphanumeric characters.
BETA_DB_PASSWORD=replace-with-random-hex
BETA_JWT_SECRET=replace-with-a-different-random-hex
BETA_ADMIN_USERNAME=beta_admin
BETA_ADMIN_PASSWORD=replace-with-a-third-random-hex
BETA_TEACHER_USERNAME=beta_teacher
BETA_TEACHER_PASSWORD=replace-with-a-fourth-random-hex
BETA_LLM_BASE_URL=http://edullm-docling-compare-ornith:8000/v1
BETA_LLM_API_KEY=local
BETA_LLM_MODEL=ornith
BETA_MODEL_NETWORK=edullm-v6_default
BETA_HTTP_PORT=18080
BETA_LAN_IP=192.168.168.199
BETA_HTTPS_PORT=18443
BETA_TLS_DIR=/path/to/private/tls
