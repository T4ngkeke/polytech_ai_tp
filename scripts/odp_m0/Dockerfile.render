# M0 experiment only: an isolated LibreOffice used to render ODP previews.
# Run it with --network none; the container never needs a network.
# Not a production image. M2 will need its own worker image (roadmap section 12).
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-impress \
        libreoffice-core \
        fonts-dejavu-core \
        fonts-liberation2 \
        fonts-noto-core \
        fonts-freefont-ttf \
    && rm -rf /var/lib/apt/lists/*

# Macros stay off inside the container as well: isolation is layered, not a single switch.
ENV HOME=/work/profile
ENTRYPOINT ["/usr/bin/soffice"]
